+    #[tokio::test]
+    async fn before_accept_gate_blocks_final_answer_until_ready_or_ended() {
+        #[derive(Clone, Copy)]
+        enum Outcome {
+            Ready,
+            Failed,
+            Ended,
+        }
+
+        for outcome in [Outcome::Ready, Outcome::Failed, Outcome::Ended] {
+            let (client, sent_count) = make_sending_client().await;
+            let incoming = incoming_offer(false);
+            let registry = client.call_registry();
+            let call_id = incoming.action.call_id();
+            registry.mark_incoming_ringing(call_id);
+            let session = wacore::voip_control::CallSession::new_incoming(
+                call_id,
+                incoming.from.clone(),
+                incoming.action.call_creator().clone(),
+            );
+            let registration = RegisteredCall::new_ringing_direct(&client, session)
+                .await
+                .expect("ringing offer");
+            let mut teardown = AnswerTeardown::new(&client, &registration);
+            let (preaccept, accept) = build_answer_signaling(
+                &incoming,
+                AudioFormat::MLOW_16KHZ_60MS,
+                false,
+                false,
+                "PREACCEPT-READINESS",
+                "ACCEPT-READINESS",
+            )
+            .expect("answer signaling");
+            let (enter_tx, enter_rx) = async_channel::bounded(1);
+            let (ready_tx, ready_rx) = async_channel::bounded(1);
+            let drive = async {
+                send_answer_node(&client, &registration, &mut teardown, preaccept).await?;
+                registration
+                    .wait_before_accept(async {
+                        enter_tx.send(()).await.expect("observed readiness gate");
+                        ready_rx.recv().await.expect("fixture readiness result")
+                    })
+                    .await?;
+                send_answer_node(&client, &registration, &mut teardown, accept).await
+            };
+            let resolve = async {
+                enter_rx.recv().await.expect("gate entered");
+                assert_eq!(sent_count.load(Ordering::SeqCst), 1);
+                match outcome {
+                    Outcome::Ready => ready_tx.send(Ok(())).await.expect("ready"),
+                    Outcome::Failed => ready_tx
+                        .send(Err(CallError::Media("not ready")))
+                        .await
+                        .expect("failed"),
+                    Outcome::Ended => terminate_call(&client, call_id),
+                }
+            };
+            let (result, ()) = tokio::time::timeout(
+                Duration::from_secs(2),
+                futures::future::join(drive, resolve),
+            )
+            .await
+            .expect("answer should resolve");
+            match outcome {
+                Outcome::Ready => assert!(result.is_ok()),
+                Outcome::Failed => assert!(matches!(result, Err(CallError::Media("not ready")))),
+                Outcome::Ended => assert!(matches!(result, Err(CallError::CallEndedDuringSetup))),
+            }
+            assert_eq!(
+                sent_count.load(Ordering::SeqCst),
+                if matches!(outcome, Outcome::Ready) { 2 } else { 1 }
+            );
+            if matches!(outcome, Outcome::Ready) {
+                teardown.disarm();
+            } else {
+                teardown.terminate(&client).await;
+                assert_eq!(registry.active_count(), 0);
+            }
+        }
+    }
+
+    #[tokio::test]
