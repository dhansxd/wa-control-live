@@ -38,0 +42,75 @@ pub(crate) const RELAY_DIAL_CEILING: Duration = Duration::from_secs(20);
+/// Give a responsive primary relay the call without opening sockets to other hosts.
+const PRIMARY_RELAY_HEAD_START: Duration = Duration::from_millis(750);
+
+type RelayConnection = (
+    Arc<dyn RelayTransport>,
+    async_channel::Receiver<RelayTransportEvent>,
+);
+
+fn relay_dial_timeout() -> MediaSetupError {
+    MediaSetupError::Connect(format!(
+        "the relay transport did not connect within {RELAY_DIAL_CEILING:?}"
+    ))
+}
+
+/// Dial the primary first and only start alternatives if it fails or is still pending.
+/// All futures stay inside the one call setup and are dropped on a winner or cancellation.
+async fn race_relay_dials<T, F, Fut>(
+    runtime: &dyn wacore::runtime::Runtime,
+    spec: &mut MediaSessionSpec,
+    dial: F,
+) -> Result<T, MediaSetupError>
+where
+    F: Fn(RelayEndpointParams) -> Fut,
+    Fut: Future<Output = Result<T, MediaSetupError>>,
+{
+    wacore::runtime::timeout(runtime, RELAY_DIAL_CEILING, async {
+        let endpoint = RelayEndpointParams::from_spec(spec).ok_or(MediaSetupError::BadEndpoint)?;
+        let primary = dial(endpoint);
+        futures::pin_mut!(primary);
+        let primary_error =
+            match wacore::runtime::timeout(runtime, PRIMARY_RELAY_HEAD_START, primary.as_mut()).await
+            {
+                Ok(Ok(connection)) => return Ok(connection),
+                Ok(Err(error)) => Some(error),
+                Err(_) => None,
+            };
+
+        let mut pending = FuturesUnordered::new();
+        for candidate in std::mem::take(&mut spec.relay_alternatives) {
+            let endpoint = RelayEndpointParams::from_alternative(&candidate, &spec.integrity_key);
+            let dial = dial(endpoint);
+            pending.push(async move { (candidate, dial.await) });
+        }
+        let alternative = async {
+            while let Some((candidate, result)) = pending.next().await {
+                if let Ok(connection) = result {
+                    return Some((candidate, connection));
+                }
+            }
+            None
+        };
+        futures::pin_mut!(alternative);
+        let (candidate, connection) = if let Some(error) = primary_error {
+            alternative.await.ok_or(error)?
+        } else {
+            // `select` polls the primary first if both are ready at the same time.
+            match select(primary, alternative).await {
+                Either::Left((Ok(connection), _)) => return Ok(connection),
+                Either::Left((Err(error), alternative)) => alternative.await.ok_or(error)?,
+                Either::Right((Some(winner), _)) => winner,
+                Either::Right((None, primary)) => return primary.await,
+            }
+        };
+
+        // The engine must authenticate STUN to the same offered host that opened transport.
+        spec.relay_ip = candidate.addr.ip().to_string();
+        spec.relay_port = candidate.addr.port();
+        spec.relay_token = candidate.relay_token;
+        spec.auth_token = candidate.auth_token;
+        log::info!("voip: inbound relay connected on an alternate offered host");
+        Ok(connection)
+    })
+    .await
+    .map_err(|_| relay_dial_timeout())?
+}
