+    /// Retain alternatives from this direct inbound offer without copying the call key.
+    #[doc(hidden)]
+    pub fn add_inbound_relay_alternatives(&mut self, relay: &RelayData) {
+        let mut hosts = HashSet::new();
+        if let Ok(primary) = self.relay_ip.parse::<Ipv4Addr>() {
+            hosts.insert(primary);
+        }
+        self.relay_alternatives = relay
+            .endpoints
+            .iter()
+            .filter_map(|endpoint| {
+                let (ip, port) = get_primary_ipv4_address(endpoint)?;
+                let ip = ip.parse::<Ipv4Addr>().ok()?;
+                let token = relay
+                    .relay_tokens
+                    .get(endpoint.token_id as usize)
+                    .filter(|token| !token.is_empty())?;
+                // Each native factory already races eligible ports on its host.
+                if port == 0 || !hosts.insert(ip) {
+                    return None;
+                }
+                Some(MediaRelayCandidate {
+                    addr: SocketAddrV4::new(ip, port),
+                    relay_token: token.clone(),
+                    auth_token: select_auth_token(&relay.auth_tokens, endpoint.auth_token_id),
+                })
+            })
+            .take(MAX_ALTERNATE_RELAY_HOSTS)
+            .collect();
+    }
